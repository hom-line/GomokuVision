<Window x:Class="GomokuVision.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gomoku Vision · Advanced" Width="1390" Height="875"
        MinWidth="760" MinHeight="470" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="#F1F5FA" FontFamily="Segoe UI">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="70"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock x:Name="Heading" Text="Gomoku Vision" FontSize="25" FontWeight="SemiBold" Foreground="#1976D2"/>
        <TextBlock x:Name="Subtitle" Text="MATLAB · Python · C#  |  C# native desktop analysis" FontSize="12" Foreground="#687F95"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock x:Name="LanguageLabel" Text="Language" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="LanguageBox" Width="142" Height="32" SelectedIndex="1"
                  SelectionChanged="LanguageBox_SelectionChanged">
          <ComboBoxItem Content="繁體中文"/>
          <ComboBoxItem Content="English"/>
        </ComboBox>
      </StackPanel>
    </DockPanel>
    <!-- Content can scroll on compact laptops / 125%-200% DPI; the footer never scrolls away. -->
    <ScrollViewer x:Name="MainContentViewport" Grid.Row="1"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  PanningMode="Both">
    <Grid MinWidth="1130" MinHeight="565"
          Width="{Binding ViewportWidth, ElementName=MainContentViewport}"
          Height="{Binding ViewportHeight, ElementName=MainContentViewport}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="355"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="285"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock x:Name="InputTitle" Text="開始辨識" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock x:Name="VideoLabel" Text="影片檔" FontWeight="SemiBold"/>
            <DockPanel Margin="0,4,0,11">
              <Button x:Name="VideoPick" Content="Browse" DockPanel.Dock="Right" Click="PickVideo_Click"/>
              <TextBox x:Name="VideoPath" VerticalContentAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </DockPanel>
            <Button x:Name="ImportOriginalButton" Content="匯入原始專題資料夾（本機私人影片）"
                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"
                    Click="ImportOriginal_Click" Margin="0,0,0,12"
                    ToolTip="Select local folder with input.mp4, checkerboard_points.csv, black.png and white.png; no footage is uploaded."/>
            <TextBlock x:Name="EngineLabel" Text="辨識引擎" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="EngineBox" SelectedIndex="0" Margin="0,0,0,15" Height="32">
              <ComboBoxItem Content="C# / OpenCvSharp" />
              <ComboBoxItem Content="Python / OpenCV" />
              <ComboBoxItem Content="MATLAB / Image Processing Toolbox" />
            </ComboBox>
            <!-- Independent historical concepts: ROI search strategy and annotation/display mode. -->
            <TextBlock x:Name="RoiModeLabel" Text="ROI 搜尋模式（辨識時使用）" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="RoiModeBox" SelectedIndex="0" Height="32" Margin="0,0,0,10">
              <ComboBoxItem Content="黑白分離 ROI（各自預篩）"/>
              <ComboBoxItem Content="共用 ROI（共同候選區）"/>
            </ComboBox>
            <TextBlock x:Name="DisplayModeLabel" Text="顯示模式（即時切換）" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="DisplayModeBox" SelectedIndex="1" Height="32" Margin="0,0,0,6"
                      SelectionChanged="DisplayModeBox_SelectionChanged">
              <ComboBoxItem Content="模式一：純辨識（綠框）"/>
              <ComboBoxItem Content="模式二：辨識＋預測（綠框／建議圈）"/>
            </ComboBox>

            <Expander x:Name="BenchmarkExpander" Header="批次比較 · CSV 匯出"
                      IsExpanded="True" Margin="0,3,0,10" Padding="0,0,0,3">
              <StackPanel Margin="3,8,2,4">
                <TextBlock x:Name="BenchmarkSpeedLabel" Text="選擇播放倍率（可複選）"
                           FontWeight="SemiBold" Margin="0,0,0,7"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                  <CheckBox x:Name="BenchmarkSpeed1" Content="1×" IsChecked="True" Margin="4,2,25,2"/>
                  <CheckBox x:Name="BenchmarkSpeed2" Content="2×" IsChecked="False" Margin="4,2,25,2"/>
                  <CheckBox x:Name="BenchmarkSpeed4" Content="4×" IsChecked="False" Margin="4,2,5,2"/>
                </StackPanel>
                <Button x:Name="AllResultsButton" Content="執行所選測試 · 匯出 CSV"
                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"
                        Click="AllResults_Click" MinHeight="40" Margin="0,0,0,8"
                        ToolTip="12 analysis cases per speed; up to 36 cases. Speed is a playback label, not a compute accelerator."/>
                <TextBlock x:Name="BenchmarkNote" Text="每選一種倍率將重跑 12 組；倍率不加速辨識運算。"
                           FontSize="11" Foreground="#637B93" TextWrapping="Wrap"/>
              </StackPanel>
            </Expander>

            <Expander x:Name="AdvancedExpander" Header="更多設定 · 校準 / 模板 / 輸出"
                      IsExpanded="False" Margin="0,1,0,10">
              <StackPanel Margin="2,10,2,6">
            <TextBlock x:Name="InputSourceNote" Text="預設 demo 是合成影片，並非原始專題影片。"
                       Foreground="#9B6A32" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock x:Name="CalibrationLabel" Text="棋盤校準 CSV（225 點）" FontWeight="SemiBold"/>
            <DockPanel Margin="0,4,0,4">
              <Button x:Name="CalibrationPick" Content="Browse" DockPanel.Dock="Right" Click="PickCalibration_Click"/>
              <TextBox x:Name="CalibrationPath" VerticalContentAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </DockPanel>
            <Button x:Name="CalibrateButton" Content="從影片四個角點建立校準" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Stretch" Click="Calibrate_Click" Margin="0,0,0,14"/>
            <TextBlock x:Name="BlackLabel" Text="黑棋模板 PNG" FontWeight="SemiBold"/>
            <DockPanel Margin="0,4,0,11">
              <Button x:Name="BlackPick" Content="Browse" DockPanel.Dock="Right" Click="PickBlack_Click"/>
              <TextBox x:Name="BlackPath" VerticalContentAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </DockPanel>
            <TextBlock x:Name="WhiteLabel" Text="白棋模板 PNG" FontWeight="SemiBold"/>
            <DockPanel Margin="0,4,0,11">
              <Button x:Name="WhitePick" Content="Browse" DockPanel.Dock="Right" Click="PickWhite_Click"/>
              <TextBox x:Name="WhitePath" VerticalContentAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </DockPanel>
            <TextBlock x:Name="OutputLabel" Text="結果輸出資料夾" FontWeight="SemiBold"/>
            <DockPanel Margin="0,4,0,14">
              <Button x:Name="OutputPick" Content="Browse" DockPanel.Dock="Right" Click="PickOutput_Click"/>
              <TextBox x:Name="OutputPath" VerticalContentAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </DockPanel>
            <Button x:Name="LoadCachedButton" Content="開啟已保存的結果（免重跑）"
                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"
                    Click="LoadCached_Click" Margin="0,0,0,12"/>
            <Button x:Name="QuickGateButton" Content="雙引擎快速驗收（合成影片）"
                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"
                    Click="QuickGate_Click" Margin="0,0,0,12"
                    ToolTip="Uses the self-authored short synthetic demo only; does not analyze historical footage."/>
            <TextBlock x:Name="SettingsTitle" Text="辨識設定" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,7,8"><TextBlock x:Name="EveryLabel" Text="取樣間隔（幀）"/>
                <TextBox x:Name="EveryValue" Text="6"/></StackPanel>
              <StackPanel Margin="0,0,0,8"><TextBlock x:Name="FullLabel" Text="全盤掃描週期"/>
                <TextBox x:Name="FullValue" Text="4"/></StackPanel>
              <StackPanel Margin="0,0,7,8"><TextBlock x:Name="ConfirmLabel" Text="確認次數"/>
                <TextBox x:Name="ConfirmValue" Text="2"/></StackPanel>
              <StackPanel Margin="0,0,0,8"><TextBlock x:Name="ScaleLabel" Text="影像比例"/>
                <TextBox x:Name="ScaleValue" Text="0.5"/></StackPanel>
              <StackPanel Margin="0,0,7,8"><TextBlock x:Name="BlackThresholdLabel" Text="黑棋 NCC 門檻"/>
                <TextBox x:Name="BlackThresholdValue" Text="0.65"/></StackPanel>
              <StackPanel Margin="0,0,0,8"><TextBlock x:Name="WhiteThresholdLabel" Text="白棋 NCC 門檻"/>
                <TextBox x:Name="WhiteThresholdValue" Text="0.75"/></StackPanel>
            </UniformGrid>
            <TextBlock x:Name="LimitLabel" Text="注意：需要固定鏡頭、已校準棋盤；預測為啟發式建議。"
                       FontSize="11" TextWrapping="Wrap" Foreground="#71869A" Margin="0,10,0,0"/>
              </StackPanel>
            </Expander>
            <TextBlock x:Name="GreenBoxNote" Text="綠框＝已確認棋子；建議圈屬啟發式預測，不代表已落子。"
                       Foreground="#4B7660" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="18">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="185"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="PreviewTitle" Text="影片分析預覽" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock x:Name="PreviewCaption" Text="Latest detection frame" Foreground="#698095" HorizontalAlignment="Right"/>
          </DockPanel>
          <Border Grid.Row="1" Background="#1C2733" CornerRadius="8" ClipToBounds="True">
            <Image x:Name="PreviewImage" Stretch="Uniform"/>
          </Border>
          <StackPanel Grid.Row="2" Margin="0,9,0,3">
            <DockPanel LastChildFill="False">
              <Button x:Name="LoadVideoButton" DockPanel.Dock="Left" Content="載入影片預覽" Style="{StaticResource SecondaryButton}"
                      Click="LoadVideoPreview_Click" Margin="0,0,7,4"/>
              <Button x:Name="VideoPlayButton" DockPanel.Dock="Left" Content="播放影片" IsEnabled="False"
                      Click="VideoPlay_Click" Margin="0,0,7,4"/>
              <ComboBox x:Name="SpeedBox" DockPanel.Dock="Left" Width="80" Height="32"
                        SelectedIndex="1" VerticalAlignment="Center" Margin="0,0,10,4"
                        ToolTip="Shared video / board playback speed" SelectionChanged="SpeedBox_SelectionChanged">
                <ComboBoxItem Content="1×" />
                <ComboBoxItem Content="2×" />
                <ComboBoxItem Content="4×" />
              </ComboBox>
              <TextBlock x:Name="FrameLabel" VerticalAlignment="Center" FontSize="11" Foreground="#607D95"
                         Text="No video loaded"/>
            </DockPanel>
            <Slider x:Name="FrameSlider" Minimum="0" Maximum="1" IsEnabled="False"
                    ValueChanged="FrameSlider_ValueChanged" AutoToolTipPlacement="TopLeft"/>
            <TextBlock x:Name="VideoLinkNote" Text="歷史影片不隨套件提供；未配對的影片僅能獨立預覽。"
                       FontSize="11" Foreground="#8D6B36" TextWrapping="Wrap"/>
          </StackPanel>
          <!-- Flexible slider avoids pushing the current-move label outside a narrow preview column. -->
          <Grid Grid.Row="3" Margin="0,7,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="60"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="PreviousMoveButton" Content="上一手" IsEnabled="False" Click="PreviousMove_Click"
                    Style="{StaticResource SecondaryButton}" MinHeight="34" Margin="0,0,5,0"/>
            <Button Grid.Column="1" x:Name="MovePlayButton" Content="播放棋譜" IsEnabled="False" Click="MovePlay_Click"
                    MinHeight="34" Margin="0,0,5,0"/>
            <Button Grid.Column="2" x:Name="NextMoveButton" Content="下一手" IsEnabled="False" Click="NextMove_Click"
                    Style="{StaticResource SecondaryButton}" MinHeight="34" Margin="0,0,6,0"/>
            <Slider Grid.Column="3" x:Name="MoveSlider" Minimum="0" Maximum="1" Value="0" IsEnabled="False"
                    VerticalAlignment="Center" TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="MoveSlider_ValueChanged" Margin="4,0"/>
            <TextBlock Grid.Column="4" x:Name="CurrentMoveLabel" Text="0 / 0" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </Grid>
          <TextBlock Grid.Row="4" x:Name="MoveTitle" Text="落子紀錄（選取可跳至該手）" FontWeight="SemiBold" Margin="0,5,0,6"/>
          <DataGrid Grid.Row="5" x:Name="MovesGrid" SelectionChanged="MovesGrid_SelectionChanged" IsReadOnly="True" AutoGenerateColumns="False"
                    CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    BorderBrush="#DFE7EF" RowHeight="28" ColumnHeaderHeight="30">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="48"/>
              <DataGridTextColumn Header="Frame" Binding="{Binding Frame}" Width="75"/>
              <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="90"/>
              <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
      <Border Grid.Column="4" Background="White" CornerRadius="12" Padding="18">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="300"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock x:Name="BoardTitle" Grid.Row="0" Text="棋盤逐手重播" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <Border Grid.Row="1" Background="#F7FAFD" BorderBrush="#E0E8EF" BorderThickness="1" CornerRadius="6">
            <Image x:Name="BoardImage" Stretch="Uniform"/>
          </Border>
          <TextBlock x:Name="RecommendationsTitle" Grid.Row="2" Text="推薦落點 Top 5" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,8"/>
          <StackPanel Grid.Row="3">
            <TextBlock x:Name="BlackSuggestion" Text="● 黑棋：尚無結果" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock x:Name="WhiteSuggestion" Text="○ 白棋：尚無結果" TextWrapping="Wrap"/>
          </StackPanel>
          <Border Grid.Row="4" Background="#F4F8FC" CornerRadius="8" Padding="12" Margin="0,22,0,0"
                  VerticalAlignment="Top">
            <TextBlock x:Name="SummaryText" Text="No analysis yet." Foreground="#627C95" TextWrapping="Wrap"/>
          </Border>
        </Grid>
      </Border>
    </Grid>
    </ScrollViewer>
    <!-- Two-row, content-sized footer: labels get their own row; buttons have explicit height. -->
    <Border Grid.Row="2" Background="White" CornerRadius="10" Margin="0,10,0,0"
            Padding="12,10" MinHeight="92">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="StatusText" Grid.Row="0" Text="Ready"
                   FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"
                   Margin="4,0,4,7" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="80"/>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="168"/>
          </Grid.ColumnDefinitions>
          <ProgressBar x:Name="Progress" Grid.Column="0" Height="10" Value="0" Maximum="100"
                       VerticalAlignment="Center" Margin="4,0,14,0" Foreground="#1976D2"/>
          <Button x:Name="OpenResultsButton" Grid.Column="1" Content="開啟結果資料夾"
                  Style="{StaticResource SecondaryButton}" Click="OpenResults_Click"
                  MinHeight="42" Margin="4,0" Padding="12,10" VerticalAlignment="Center"/>
          <Button x:Name="CancelButton" Grid.Column="2" Content="取消分析" IsEnabled="False"
                  Background="#C14343" Click="Cancel_Click" MinHeight="42"
                  Margin="4,0" Padding="12,10" VerticalAlignment="Center"/>
          <Button x:Name="RunButton" Grid.Column="3" Content="開始辨識與預測"
                  Click="Analyze_Click" FontWeight="SemiBold" MinHeight="42"
                  Margin="4,0" Padding="12,10" VerticalAlignment="Center"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
